# Edison ticketing — environment template
#
# Copy to .env.local and fill in from `npm run db:status` for local work:
#   cp .env.example .env.local
#
# .env.local is gitignored. Never commit a real value from a hosted project.

# --- Public: sent to the browser by design -------------------------------
# The anon key is only useful together with row-level security, which is what
# actually protects the data. Both of these are safe to expose.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# The only origin used to build setup/recovery callback links. Nothing accepts
# a redirect target from a query parameter, so this is the whole allowlist.
NEXT_PUBLIC_APP_ORIGIN=http://127.0.0.1:3000

# --- Server only: NEVER prefix with NEXT_PUBLIC_ --------------------------
# Bypasses row-level security completely. Used only for creating auth users,
# generating setup/recovery links, and the app_trusted_* database functions.
# It must never be imported from a client component.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# --- Google sign-in -------------------------------------------------------
# Read by supabase/config.toml through env(), so no credential is committed.
# Create an OAuth client (type "Web application") in Google Cloud and set its
# authorized redirect URI to <SUPABASE_URL>/auth/v1/callback — NOT the app's own
# /auth/callback, which is where Supabase sends the browser afterwards.
# With these unset the provider refuses the request and the browser lands back
# on /login with a "sign-in did not complete" notice.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=replace-with-google-oauth-client-secret

# --- Outbound mail (optional) --------------------------------------------
# Only used to send invite messages. An invite is a database row, not a link, so
# mail is a convenience: with no key set, creating an invite still succeeds and
# the administration screen hands over the message to send by hand.
# MAIL_FROM must be an address on a domain verified with Resend.
RESEND_API_KEY=replace-with-resend-api-key
MAIL_FROM=Edison Helpdesk <helpdesk@edison.example>

# --- AI assistant (optional) ----------------------------------------------
# The key the server encrypts each technician's ChatGPT OAuth tokens with,
# AES-256-GCM, before they are written to `ai_connections`. It must decode to
# exactly 32 bytes, and it is what turns the assistant on: with this unset the
# panel says the assistant is not configured and no token can be stored.
# Generate one with:
#   openssl rand -base64 32
# Rotating it makes every stored connection unreadable, so everybody has to
# connect their ChatGPT account again. Never prefix it with NEXT_PUBLIC_.
AI_TOKEN_KEY=replace-with-openssl-rand-base64-32
